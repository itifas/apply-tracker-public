// Cloudflare Worker that serves the static demo (frontend/out).
// Build command:  npm ci && npm run build:demo
// Deploy command: npx wrangler deploy
{
	"name": "apply-tracker-demo",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./out",
		"not_found_handling": "404-page"
	},
	// Matches the Observability settings in the Cloudflare dashboard.
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": false,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"issues": {
			"enabled": true
		}
	}
}
